PORT=8080
SERVER_MODE=local
JWT_SECRET=this-is-a-very-long-secret-key-for-jwt-signing-please-change-it-for-production

WORKSPACE_DIR=workspace
ARDUINO_DATA_DIR=data
ARDUINO_CLI_PATH=arduino-cli
ARDUINO_CONFIG_FILE=arduino-cli.yaml
ARDUINO_CLI_VERSION=1.5.1
ARDUINO_CLI_DOWNLOAD_BASE_URL=https://downloads.arduino.cc/arduino-cli/

MAX_CONCURRENT_JOBS=2
COMPILE_TIMEOUT_SEC=60

COMPILER_ALLOWED_ORIGINS=
